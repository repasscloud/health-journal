    {
      "name": "medication_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medication_events\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"medication_id\" TEXT NOT NULL REFERENCES medications(id), \"regimen_id\" TEXT REFERENCES medication_regimens(id), \"occurrence_key\" TEXT, \"status\" TEXT NOT NULL CHECK (status IN ('taken', 'skipped', 'missed', 'unknown')), \"intended_at\" INTEGER, \"taken_at\" INTEGER, \"recorded_at\" INTEGER NOT NULL, \"occurred_at\" INTEGER, \"amount\" REAL NOT NULL CHECK (amount > 0), \"unit\" TEXT NOT NULL CHECK (length(trim(unit)) > 0), \"legacy_medication_snapshot\" TEXT, \"catalogue_snapshot\" TEXT, \"regimen_snapshot\" TEXT, \"notes\" TEXT, \"corrects_id\" TEXT UNIQUE REFERENCES medication_events(id), \"correction_reason\" TEXT, CHECK((status = 'taken' AND taken_at IS NOT NULL)OR(status != 'taken' AND taken_at IS NULL)), CHECK((legacy_medication_snapshot IS NOT NULL AND catalogue_snapshot IS NULL AND regimen_snapshot IS NULL AND notes IS NULL AND corrects_id IS NULL)OR(legacy_medication_snapshot IS NULL AND catalogue_snapshot IS NOT NULL AND occurred_at IS NOT NULL AND occurred_at <= recorded_at AND(taken_at IS NULL OR taken_at = occurred_at)AND((regimen_id IS NULL)=(regimen_snapshot IS NULL)))), CHECK((corrects_id IS NULL AND correction_reason IS NULL)OR(corrects_id IS NOT NULL AND corrects_id != id AND correction_reason IS NOT NULL AND length(trim(correction_reason)) > 0)));"
        }
      ]
    },
