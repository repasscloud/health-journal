          "sql": "CREATE TABLE IF NOT EXISTS \"medications\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"name\" TEXT NOT NULL CHECK (length(trim(name)) > 0), \"strength\" TEXT NOT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
