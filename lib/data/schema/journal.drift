CREATE TABLE profile (
  singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
  name TEXT,
  date_of_birth TEXT
);
CREATE TABLE medications (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL CHECK (length(trim(name)) > 0),
  strength TEXT NOT NULL,
  archived INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0,1)),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  generic_name TEXT,
  brand TEXT,
  form TEXT,
  strength_unit TEXT,
  instructions TEXT,
  reason TEXT,
  prescribed_by TEXT,
  notes TEXT,
  started_at INTEGER,
  stopped_at INTEGER CHECK (stopped_at >= started_at),
  paused_at INTEGER CHECK (paused_at >= started_at)
);
CREATE TABLE medication_regimens (
  id TEXT NOT NULL PRIMARY KEY,
  medication_id TEXT NOT NULL REFERENCES medications(id),
  amount REAL NOT NULL CHECK (amount > 0),
  unit TEXT NOT NULL CHECK (length(trim(unit)) > 0),
  kind TEXT NOT NULL CHECK (kind IN ('fixed','prn','course')),
  effective_from INTEGER NOT NULL,
  effective_to INTEGER CHECK (effective_to >= effective_from),
  instructions_snapshot TEXT NOT NULL,
  zone_policy TEXT CHECK (zone_policy = 'deviceLocal'),
  reminder_enabled INTEGER CHECK (reminder_enabled IN (0,1))
);
CREATE TABLE medication_events (
  id TEXT NOT NULL PRIMARY KEY,
  medication_id TEXT NOT NULL REFERENCES medications(id),
  regimen_id TEXT REFERENCES medication_regimens(id),
  occurrence_key TEXT,
  status TEXT NOT NULL CHECK (status IN ('taken','skipped','missed','unknown')),
  intended_at INTEGER,
  taken_at INTEGER,
  recorded_at INTEGER NOT NULL,
  occurred_at INTEGER,
  amount REAL NOT NULL CHECK (amount > 0),
  unit TEXT NOT NULL CHECK (length(trim(unit)) > 0),
  legacy_medication_snapshot TEXT,
  catalogue_snapshot TEXT,
  regimen_snapshot TEXT,
  notes TEXT,
  corrects_id TEXT UNIQUE REFERENCES medication_events(id),
  correction_reason TEXT,
  original_zone_label TEXT,
  original_offset_minutes INTEGER CHECK (original_offset_minutes BETWEEN -1439 AND 1439),
  CHECK ((status = 'taken' AND taken_at IS NOT NULL) OR
         (status != 'taken' AND taken_at IS NULL)),
  CHECK ((legacy_medication_snapshot IS NOT NULL AND catalogue_snapshot IS NULL
          AND regimen_snapshot IS NULL AND notes IS NULL AND corrects_id IS NULL)
      OR (legacy_medication_snapshot IS NULL AND catalogue_snapshot IS NOT NULL
          AND occurred_at IS NOT NULL AND occurred_at <= recorded_at
          AND (taken_at IS NULL OR taken_at = occurred_at)
          AND ((regimen_id IS NULL) = (regimen_snapshot IS NULL)))),
  CHECK ((corrects_id IS NULL AND correction_reason IS NULL) OR
         (corrects_id IS NOT NULL AND corrects_id != id AND
          correction_reason IS NOT NULL AND length(trim(correction_reason)) > 0))
);
CREATE INDEX medication_events_time ON medication_events(recorded_at);
CREATE TABLE symptom_entries (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL CHECK (length(trim(title)) > 0),
  onset_at INTEGER NOT NULL,
  end_at INTEGER CHECK (end_at >= onset_at),
  recorded_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  severity INTEGER CHECK (severity BETWEEN 0 AND 10),
  notes TEXT NOT NULL DEFAULT '',
  category TEXT,
  pattern TEXT CHECK (pattern IN ('continuous','intermittent')),
  triggers TEXT,
  relief_measures TEXT,
  perceived_effect TEXT
);
CREATE TABLE pain_markers (
  id TEXT NOT NULL PRIMARY KEY,
  symptom_id TEXT NOT NULL REFERENCES symptom_entries(id),
  body_view TEXT NOT NULL CHECK (body_view IN ('front','back')),
  x REAL NOT NULL CHECK (x BETWEEN 0 AND 1),
  y REAL NOT NULL CHECK (y BETWEEN 0 AND 1),
  radius REAL CHECK (radius BETWEEN 0 AND 1),
  body_asset_version TEXT NOT NULL,
  region_code TEXT NOT NULL,
  laterality TEXT NOT NULL CHECK (laterality IN ('left','right','midline','bilateral','unspecified')),
  severity INTEGER NOT NULL CHECK (severity BETWEEN 0 AND 10),
  pain_type TEXT NOT NULL CHECK (pain_type IN ('aching','sharp','burning','throbbing','tingling','other'))
);
CREATE INDEX symptoms_time ON symptom_entries(onset_at);

CREATE TABLE medication_schedule_rules (
  id TEXT NOT NULL PRIMARY KEY,
  regimen_id TEXT NOT NULL REFERENCES medication_regimens(id),
  weekday INTEGER NOT NULL CHECK (weekday BETWEEN 1 AND 7),
  minute_of_day INTEGER NOT NULL CHECK (minute_of_day BETWEEN 0 AND 1439),
  UNIQUE (regimen_id, weekday, minute_of_day)
);

CREATE TABLE measurements (
  id TEXT NOT NULL PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('weight','bloodPressure','heartRate','temperature','glucose','sleep')),
  value REAL NOT NULL CHECK (value > 0 AND coalesce(value - value, 1) = 0),
  secondary REAL CHECK (secondary IS NULL OR (secondary > 0 AND coalesce(secondary - secondary, 1) = 0)),
  measured_at INTEGER NOT NULL,
  recorded_at INTEGER NOT NULL,
  source TEXT NOT NULL DEFAULT 'manual' CHECK (source = 'manual'),
  CHECK ((kind = 'bloodPressure') = (secondary IS NOT NULL))
);
CREATE INDEX measurements_time ON measurements(measured_at);

CREATE TABLE journal_notes (
  id TEXT NOT NULL PRIMARY KEY,
  occurred_at INTEGER NOT NULL,
  recorded_at INTEGER NOT NULL,
  body TEXT NOT NULL CHECK (length(trim(body)) > 0)
);
CREATE INDEX journal_notes_time ON journal_notes(occurred_at);

CREATE TABLE audit_events (
  id TEXT NOT NULL PRIMARY KEY,
  record_type TEXT NOT NULL,
  record_id TEXT NOT NULL,
  action_code TEXT NOT NULL,
  recorded_at INTEGER NOT NULL,
  snapshot TEXT
);
CREATE INDEX audit_events_record ON audit_events(record_type, record_id, recorded_at);

CREATE TABLE journal_settings (
  singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
  weight_unit TEXT NOT NULL DEFAULT 'kg' CHECK (weight_unit IN ('kg','lb')),
  temperature_unit TEXT NOT NULL DEFAULT 'celsius' CHECK (temperature_unit IN ('celsius','fahrenheit')),
  glucose_unit TEXT NOT NULL DEFAULT 'mmol/L' CHECK (glucose_unit IN ('mmol/L','mg/dL')),
  appearance TEXT NOT NULL DEFAULT 'system' CHECK (appearance IN ('system','light','dark'))
);

CREATE TABLE symptom_tags (
  symptom_id TEXT NOT NULL REFERENCES symptom_entries(id),
  tag TEXT NOT NULL CHECK (length(trim(tag)) > 0),
  PRIMARY KEY (symptom_id, tag)
);
